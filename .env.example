# ─── EduConnect AI configuration ────────────────────────────────────────────
# Copy to .env.local. Nothing here is required for the local demo.

# Public URL of the app (used in emails, e.g. password-reset links).
APP_URL=http://localhost:3000

# Demo mode: seeds a fictional school on first start and enables one-click
# demo sign-in. Set to "false" in production.
DEMO_MODE=true
# Optional: give every demo account this password (otherwise demo accounts
# can only be used through the one-click demo panel).
# DEMO_PASSWORD=

# ─── Database (MongoDB) ─────────────────────────────────────────────────────
# Production: your MongoDB Atlas connection string (set it in Netlify → Site
# configuration → Environment variables, never in this file or in git). Use an EU
# region. Atlas → Network Access must allow 0.0.0.0/0 (Netlify has no fixed IPs).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# MONGODB_DB=educonnect
# MONGODB_POOL_SIZE=10
#
# Without MONGODB_URI (local development only) an embedded MongoDB is started
# automatically and stored in .data/mongo.
# MONGO_DATA_DIR=.data/mongo

# Encryption key for sensitive free text (check-in notes, counselor notes).
# REQUIRED in production. Generate once and keep it safe — losing it makes
# those fields unreadable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=

# ─── AI provider ────────────────────────────────────────────────────────────
# Without a key, the tutor and wellbeing assistant run in offline demo mode.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ─── Email (optional) ───────────────────────────────────────────────────────
# Without these, emails are printed to the server log in development only.
# RESEND_API_KEY=
# EMAIL_FROM="EduConnect AI <no-reply@your-school-domain.ro>"

# ─── Android app (Capacitor) — see docs/ANDROID.md ──────────────────────────
# Used by `npm run android:prod` / `npx cap sync` (not by Next.js): the URL the
# Android app loads. Default for the emulator: http://10.0.2.2:3000
# CAP_SERVER_URL=https://educonnectnova.netlify.app
# Optional: serve the APK from elsewhere (e.g. a GitHub Release) instead of
# public/downloads/educonnect.apk. Shown on /install.
# ANDROID_APK_URL=
